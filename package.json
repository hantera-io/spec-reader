{
  "name": "@hantera/spec-reader",
  "version": "1.0.0",
  "description": "Dead-simple markdown spec reader with light/dark theme, mermaid, grafiq and Filtrera syntax highlighting.",
  "type": "module",
  "scripts": {
    "start": "node ./bin/sr.js",
    "install-global": "npm install -g ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "sr": "./bin/sr.js"
