    "chokidar": "^3.6.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "mermaid": "^11.4.1",
    "open": "^10.1.0",
    "panzoom": "^9.4.4",
    "shiki": "^1.24.0",
    "vite": "^5.4.21",
    "vue": "^3.5.13"
